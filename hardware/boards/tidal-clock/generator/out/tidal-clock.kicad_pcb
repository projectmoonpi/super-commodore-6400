				(thickness 0.2104)
				(material "FR4")
				(epsilon_r 4.4)
				(loss_tangent 0.02)
			)
			(layer "In1.Cu"
				(type "copper")
				(thickness 0.0175)
			)
			(layer "dielectric 2"
				(type "core")
				(thickness 1.065)
